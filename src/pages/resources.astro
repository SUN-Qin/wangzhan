---
import MainGridLayout from "../layouts/MainGridLayout.astro";
---
<MainGridLayout title="资源导航" description="AI、设计、开发和效率工具的实用资源导航。">
  <div class="card-base p-6 md:p-9"><h1 class="text-3xl font-bold mb-3">资源导航</h1><p class="text-75 mb-8">这里收集适合日常工作流的官方资源和学习入口。</p><div class="grid gap-4 md:grid-cols-2"><a class="btn-card rounded-xl p-5" href="https://huggingface.co/" target="_blank" rel="nofollow noopener"><strong>Hugging Face</strong><span class="block text-sm text-75 mt-1">开源模型、数据集与 AI 社区</span></a><a class="btn-card rounded-xl p-5" href="https://www.producthunt.com/" target="_blank" rel="nofollow noopener"><strong>Product Hunt</strong><span class="block text-sm text-75 mt-1">发现新软件和生产力工具</span></a><a class="btn-card rounded-xl p-5" href="https://github.com/trending" target="_blank" rel="nofollow noopener"><strong>GitHub Trending</strong><span class="block text-sm text-75 mt-1">追踪热门开源项目</span></a><a class="btn-card rounded-xl p-5" href="https://www.notion.so/templates" target="_blank" rel="nofollow noopener"><strong>Notion Templates</strong><span class="block text-sm text-75 mt-1">效率模板与工作流灵感</span></a></div></div>
</MainGridLayout>
